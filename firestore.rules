rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User Profile Rules
    // Users can read other authenticated user profiles (for search and chat)
    // Users can only create and update their OWN profile
    // Client is strictly forbidden from assigning itself admin roles or claims
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'isModerator', 'roles'])
                    && request.resource.data.email == request.auth.token.email;
                    
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isModerator', 'roles', 'createdAt', 'userId'])
                    && request.resource.data.email == resource.data.email;
                    
      allow delete: if false; // Profiles cannot be hard-deleted from client
    }
    
    // Unique Username Reservation Rules
    // Each username maps to a document where doc id is the lowercase username.
    // Document can only be created if it does not already exist.
    match /usernames/{username} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated()
                    && !exists(/databases/$(database)/documents/usernames/$(username))
                    && request.resource.data.uid == request.auth.uid;
                    
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
                    
      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    // Conversations and Realtime Messages Rules
    match /conversations/{conversationId} {
      // User can only read conversation if their UID is in memberIds
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      
      // User can create conversation if authenticated and included in memberIds
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberIds;
      
      // User can update lastMessage / lastMessageAt only if they are a member
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Read only if authenticated and a member of the parent conversation
        allow read: if isAuthenticated() && 
                    request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
                    
        // Send message only if authenticated, senderId matches auth.uid, text is non-empty and <= 2000 chars
        allow create: if isAuthenticated() && 
                     request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds &&
                     request.resource.data.senderId == request.auth.uid &&
                     request.resource.data.text is string &&
                     request.resource.data.text.size() > 0 &&
                     request.resource.data.text.size() <= 2000;
                     
        allow update, delete: if false; // Tamper protection
      }
    }
    
    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
